# Application settings
APP_NAME=personal-data-lake-api
APP_ENV=development
APP_VERSION=0.1.0
APP_PORT=8000

# PostgreSQL connection
# This will be used in feature/database-postgres
DATABASE_URL=postgresql://user:password@postgres:5432/personal_data_lake

# MinIO object storage
# This will be used in feature/storage-minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_RAW=raw

# Application settings
APP_NAME=personal-data-lake-api
APP_ENV=development
APP_VERSION=0.1.0
APP_PORT=8000

# Optional root path for reverse proxy environments.
# Example for code-server proxy: /proxy/8000
APP_ROOT_PATH=

# PostgreSQL connection
# This will be used in feature/database-postgres
DATABASE_URL=postgresql://user:password@postgres:5432/personal_data_lake

# MinIO object storage
# This is used in feature/storage-minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_RAW=raw
MINIO_SECURE=false

# MinIO local development console
MINIO_CONSOLE_PORT=9001

# Git metadata is not needed inside the Docker image
.git/
.gitignore

# Python cache files
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments should stay outside the Docker image
.venv/
venv/
env/

# Test and coverage outputs
.pytest_cache/
.coverage
htmlcov/

# Local environment files must not be copied into the image
.env
.env.*
!.env.example

# Local editor settings
.vscode/
.idea/

# Local logs and temporary files
*.log
logs/
tmp/
data/
uploads/

# Local database and storage volumes
postgres-data/
pgdata/
minio-data/
storage/

# OS files
.DS_Store
Thumbs.db
